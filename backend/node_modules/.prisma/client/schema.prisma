generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum CarStatus {
  AVAILABLE
  RENTED
}

enum RentalStatus {
  ACTIVE
  FINISHED
}

model User {
  id        String    @id @default(uuid())
  firstName String    @default("")
  lastName  String    @default("")
  birthDate DateTime?
  email     String    @unique
  password  String
  role      Role      @default(USER)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  rentals Rental[]

  @@index([role])
}

model Car {
  id             String    @id @default(uuid())
  brand          String
  model          String
  year           Int
  startPrice     Float     @default(0)
  pricePerMinute Float     @default(0)
  status         CarStatus @default(AVAILABLE)
  lat            Float
  lng            Float
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  rentals Rental[]

  @@index([brand])
  @@index([model])
  @@index([status])
}

model Rental {
  id         String       @id @default(uuid())
  userId     String
  carId      String
  startDate  DateTime
  endDate    DateTime?
  status     RentalStatus @default(ACTIVE)
  totalPrice Float
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])
  car  Car  @relation(fields: [carId], references: [id])

  @@index([userId])
  @@index([carId])
  @@index([startDate])
  @@index([endDate])
  @@index([status])
}
